<p style="margin:0 0 14px 0;font-size:15px;line-height:1.6;color:#0f172a;">
  Hello <strong>{{recipientName}}</strong>,
</p>
<p style="margin:0 0 22px 0;font-size:14px;line-height:1.65;color:#334155;">
  We received a request to reset the password for your <strong>{{brandName}}</strong> account. Enter the 6-digit verification code below to verify your identity before setting a new password:
</p>

<div style="margin:0 0 24px 0;padding:22px 20px;background-color:#f8fafc;border:1px solid #cbd5e1;border-radius:12px;text-align:center;">
  <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1.2px;color:#64748b;margin-bottom:8px;">
    One-Time Verification Code
  </div>
  <div style="font-family:'SFMono-Regular',Consolas,'Liberation Mono',Menlo,monospace;font-size:32px;font-weight:800;letter-spacing:10px;color:#0f172a;padding-left:10px;">
    {{otpCode}}
  </div>
</div>

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#eff6ff;border-left:3px solid #2563eb;border-radius:6px;margin-bottom:8px;">
  <tr>
    <td style="padding:12px 14px;font-size:12px;line-height:1.55;color:#1e3a8a;">
      This code is valid for <strong>{{expiresMinutes}} minutes</strong> and can only be used once. If you did not request a password reset, you can safely ignore this email.
    </td>
  </tr>
</table>
