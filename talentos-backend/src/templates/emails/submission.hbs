<p style="margin:0 0 14px 0;font-size:15px;line-height:1.6;color:#0f172a;">
  Hello <strong>{{recipientName}}</strong>,
</p>
<p style="margin:0 0 20px 0;font-size:14px;line-height:1.65;color:#334155;">
  Please review the consultant profile submitted for <strong>{{requirementTitle}}</strong> at <strong>{{clientName}}</strong>:
</p>

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 24px 0;background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;">
  <tr>
    <td style="padding:16px 20px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td style="font-size:12px;color:#64748b;padding:5px 0;">Consultant</td>
          <td align="right" style="font-size:13px;font-weight:600;color:#0f172a;padding:5px 0;">{{candidateName}}</td>
        </tr>
        <tr>
          <td style="font-size:12px;color:#64748b;padding:5px 0;border-top:1px solid #e2e8f0;">Work Authorization</td>
          <td align="right" style="font-size:13px;font-weight:600;color:#0f172a;padding:5px 0;border-top:1px solid #e2e8f0;">{{workAuth}}</td>
        </tr>
        <tr>
          <td style="font-size:12px;color:#64748b;padding:5px 0;border-top:1px solid #e2e8f0;">Bill Rate</td>
          <td align="right" style="font-size:13px;font-weight:600;color:#0f172a;padding:5px 0;border-top:1px solid #e2e8f0;">{{rate}}</td>
        </tr>
        <tr>
          <td style="font-size:12px;color:#64748b;padding:5px 0;border-top:1px solid #e2e8f0;">Location</td>
          <td align="right" style="font-size:13px;font-weight:600;color:#0f172a;padding:5px 0;border-top:1px solid #e2e8f0;">{{location}}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p style="margin:0;font-size:13px;line-height:1.6;color:#334155;">
  Best regards,<br />
  <strong>{{senderName}}</strong><br />
  <span style="color:#64748b;">{{brandName}}</span>
</p>
