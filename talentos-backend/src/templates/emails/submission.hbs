<h2 style="margin:0 0 12px 0;font-size:19px;line-height:1.35;font-weight:600;color:#111827;letter-spacing:-0.25px;">
  Candidate Profile Submission
</h2>
<p style="margin:0 0 22px 0;font-size:14px;line-height:1.65;color:#4b5563;">
  Hi {{recipientName}}, please review the consultant profile submitted for <strong style="color:#111827;font-weight:600;">{{requirementTitle}}</strong> at <strong style="color:#111827;font-weight:600;">{{clientName}}</strong>.
</p>

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 24px 0;background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;">
  <tr>
    <td style="padding:14px 18px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td style="font-size:12px;color:#6b7280;padding:5px 0;">Consultant</td>
          <td align="right" style="font-size:13px;font-weight:600;color:#111827;padding:5px 0;">{{candidateName}}</td>
        </tr>
        <tr>
          <td style="font-size:12px;color:#6b7280;padding:6px 0;border-top:1px solid #e5e7eb;">Work Authorization</td>
          <td align="right" style="font-size:13px;font-weight:600;color:#111827;padding:6px 0;border-top:1px solid #e5e7eb;">{{workAuth}}</td>
        </tr>
        <tr>
          <td style="font-size:12px;color:#6b7280;padding:6px 0;border-top:1px solid #e5e7eb;">Bill Rate</td>
          <td align="right" style="font-size:13px;font-weight:600;color:#111827;padding:6px 0;border-top:1px solid #e5e7eb;">{{rate}}</td>
        </tr>
        <tr>
          <td style="font-size:12px;color:#6b7280;padding:5px 0;border-top:1px solid #e5e7eb;">Location</td>
          <td align="right" style="font-size:13px;font-weight:600;color:#111827;padding:5px 0;border-top:1px solid #e5e7eb;">{{location}}</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p style="margin:0;font-size:13px;line-height:1.6;color:#4b5563;">
  Best regards,<br />
  <strong style="color:#111827;font-weight:600;">{{senderName}}</strong><br />
  <span style="color:#6b7280;">{{brandName}}</span>
</p>
