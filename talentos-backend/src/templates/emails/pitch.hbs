{{#if candidateName}}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 22px 0;background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;">
  <tr>
    <td style="padding:14px 18px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td style="font-size:12px;color:#6b7280;padding:3px 0;">Candidate</td>
          <td align="right" style="font-size:13px;font-weight:600;color:#111827;padding:3px 0;">{{candidateName}}</td>
        </tr>
        {{#if requirementTitle}}
        <tr>
          <td style="font-size:12px;color:#6b7280;padding:5px 0 3px 0;border-top:1px solid #e5e7eb;">Role</td>
          <td align="right" style="font-size:13px;font-weight:600;color:#111827;padding:5px 0 3px 0;border-top:1px solid #e5e7eb;">{{requirementTitle}}</td>
        </tr>
        {{/if}}
        {{#if clientName}}
        <tr>
          <td style="font-size:12px;color:#6b7280;padding:5px 0 3px 0;border-top:1px solid #e5e7eb;">Client</td>
          <td align="right" style="font-size:13px;font-weight:600;color:#111827;padding:5px 0 3px 0;border-top:1px solid #e5e7eb;">{{clientName}}</td>
        </tr>
        {{/if}}
      </table>
    </td>
  </tr>
</table>
{{/if}}

{{{formattedParagraphs}}}
