# TalentOS Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database routing (in_house vs external)
DB_LOCATION=in_house
DB_USER=talentos_admin
DB_PASSWORD=talentos_secure_password_2026
DB_NAME=talentos_crm
DB_PORT=5432
DB_HOST=localhost

EXTERNAL_DATABASE_URL=

# SMTP Credentials
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@talentos-agency.com
SMTP_PASS=secret
SMTP_FROM_NAME="TalentOS Recruitment Desk"
SMTP_FROM_EMAIL=notifications@talentos-agency.com

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_512bit
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_512bit
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Microservice URL
RESUME_PARSER_SERVICE_URL=http://localhost:8000

