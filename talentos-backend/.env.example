# TalentOS Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database routing (in_house vs external)
DB_LOCATION=in_house
DB_USER=talentos_admin
DB_PASSWORD=talentos_secure_password_2026
DB_NAME=talentos_crm
DB_PORT=5432
DB_HOST=localhost

EXTERNAL_DATABASE_URL=

# SMTP Credentials
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@talentos-agency.com
SMTP_PASS=secret
SMTP_FROM_NAME="TalentOS Recruitment Desk"
SMTP_FROM_EMAIL=notifications@talentos-agency.com

# JWT & Encryption Secrets
# Production requires strong random secrets (>= 32 chars for JWT, >= 16 chars for settings encryption)
JWT_ACCESS_SECRET=replace-with-a-cryptographically-random-64-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-secret
SETTINGS_ENCRYPTION_KEY=replace-with-random-32-byte-settings-encryption-key
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost:3000
ALLOW_DEMO_DOMAIN_JOIN=false

# Microservice URL
RESUME_PARSER_SERVICE_URL=http://localhost:8000

# Original CV Storage (local | s3 | cloudflare)
CV_STORAGE_PROVIDER=local
CV_LOCAL_DIR=./uploads/cv

# AWS S3 (when CV_STORAGE_PROVIDER=s3)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_PREFIX=

# Cloudflare R2 (when CV_STORAGE_PROVIDER=cloudflare)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PREFIX=

