# ==============================================================================
# SquadPipe Unified Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=3000
BACKEND_PORT=5001
PARSER_PORT=8000

# ------------------------------------------------------------------------------
# Database Routing (in_house OR external)
# ------------------------------------------------------------------------------
# Choose: "in_house" (launches dockerized postgres) or "external" (uses remote db)
DB_LOCATION=in_house

# 1. In-House Docker PostgreSQL Configuration (Used if DB_LOCATION=in_house)
DB_USER=squadpipe_admin
DB_PASSWORD=squadpipe_secure_password_2026
DB_NAME=squadpipe_crm
DB_PORT=5432
DB_HOST=postgres

# 2. External / Cloud PostgreSQL Configuration (Used if DB_LOCATION=external)
EXTERNAL_DB_HOST=aws-rds.yourdomain.com
EXTERNAL_DB_PORT=5432
EXTERNAL_DB_USER=remote_user
EXTERNAL_DB_PASSWORD=remote_password
EXTERNAL_DB_NAME=production_crm
EXTERNAL_DB_SSL=true
# Or complete external connection string:
EXTERNAL_DATABASE_URL=postgresql://remote_user:remote_password@aws-rds.yourdomain.com:5432/production_crm?sslmode=require

# ------------------------------------------------------------------------------
# SMTP Email Configuration (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@squadpipe-agency.com
SMTP_PASS=super_secret_smtp_key
SMTP_FROM_NAME="SquadPipe Recruitment Desk"
SMTP_FROM_EMAIL=noreply@squadpipe-agency.com

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# ------------------------------------------------------------------------------
# Production requires a random >= 32-char JWT_ACCESS_SECRET and >= 16-char SETTINGS_ENCRYPTION_KEY
JWT_ACCESS_SECRET=replace-with-a-cryptographically-random-64-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-secret
SETTINGS_ENCRYPTION_KEY=replace-with-random-32-byte-settings-encryption-key
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost:3000
ALLOW_DEMO_DOMAIN_JOIN=false
OTP_DEV_FALLBACK=false

# ------------------------------------------------------------------------------
# Microservice Networking URLs
# ------------------------------------------------------------------------------
RESUME_PARSER_SERVICE_URL=http://resume-parser:8000
RESUME_PARSER_API_KEY=replace-with-random-32-char-internal-parser-key
BACKEND_SERVICE_URL=http://backend:5000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Original CV File Storage (local | s3 | cloudflare)
# ------------------------------------------------------------------------------
# Controls where uploaded candidate CVs are stored under tenant-isolated,
# timestamped unique filenames: tenants/<tenantId>/cvs/<timestamp>_<id>_<name>
CV_STORAGE_PROVIDER=local
CV_LOCAL_DIR=/app/uploads/cv

# AWS S3 (Used when CV_STORAGE_PROVIDER=s3)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_PREFIX=

# Cloudflare R2 (Used when CV_STORAGE_PROVIDER=cloudflare)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_REGION=auto
# Optional strict jurisdiction lock ("eu" for UK/EU, "us" for US). Leave blank for default/apac buckets.
CLOUDFLARE_R2_JURISDICTION=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PREFIX=

# ------------------------------------------------------------------------------
# Regional Deployment & Privacy Compliance (IN | UK | US)
# ------------------------------------------------------------------------------
# Set per-server in .env with zero code changes:
# - India server (Mumbai): DEPLOYMENT_REGION=IN, EXTERNAL_DATABASE_URL=<ap-south-1 RDS>, CV_STORAGE_PROVIDER=s3, AWS_S3_REGION=ap-south-1 (or R2)
# - UK/EU server (London): DEPLOYMENT_REGION=UK, EXTERNAL_DATABASE_URL=<eu-west-2 RDS>, CV_STORAGE_PROVIDER=cloudflare, CLOUDFLARE_R2_JURISDICTION=eu
# - US server (Virginia):  DEPLOYMENT_REGION=US, EXTERNAL_DATABASE_URL=<us-east-1 RDS>, CV_STORAGE_PROVIDER=cloudflare, CLOUDFLARE_R2_JURISDICTION=us
DEPLOYMENT_REGION=IN
# Informational review-period window in days (background cron only rotates logs; candidates are never auto-deleted)
CANDIDATE_RETENTION_DAYS=365
PRIVACY_GRIEVANCE_EMAIL=privacy@squadpipe.com
PRIVACY_POLICY_URL=https://squadpipe.com/privacy-policy

# ------------------------------------------------------------------------------
# AI Provider Configuration (none | cloudflare | openai | gemini | anthropic | ollama | custom)
# ------------------------------------------------------------------------------
# Set AI_PROVIDER=none to run 100% offline/non-AI with zero external API keys.
AI_PROVIDER=none
AI_FALLBACK_TO_OFFLINE=true
AI_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=16000
AI_MODEL_FAST=
AI_MODEL_SMART=
AI_EMBEDDING_MODEL=
AI_GATEWAY_BASE_URL=
VECTOR_PROVIDER=pgvector
AI_ACTION_CENTER_AGENT=false
AI_ALLOW_BYO_KEY=false
# SaaS plans & monthly AI credit quotas are seeded and managed in PostgreSQL (SubscriptionPlan / TenantSubscription).
# Optional secret (>= 24 chars) enabling /api/v1/platform/plans, /platform/tenants/:tenantId/ai-entitlement & /ai-credits
PLATFORM_ADMIN_SECRET=

# Cloudflare Workers AI (AI_PROVIDER=cloudflare)
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=

# OpenAI (AI_PROVIDER=openai)
OPENAI_API_KEY=

# Google Gemini (AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Anthropic Claude (AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Self-Hosted Ollama / OpenAI-Compatible Endpoint (AI_PROVIDER=ollama or custom)
AI_CUSTOM_BASE_URL=http://localhost:11434/v1
AI_CUSTOM_API_KEY=

