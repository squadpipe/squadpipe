# ==============================================================================
# SquadPipe Root Orchestrator .gitignore
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment variables & local secrets
.env
!.env.example
*.env.local

# Dependency directories
node_modules/
vendor/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
ENV/

# Production build outputs
dist/
build/
*.egg-info/

# Docker persistent local volume data
docker/postgres_data/
*.data/
talentos-backend/uploads/
uploads/

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and Editor configs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

